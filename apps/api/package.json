    "eval": "tsx --env-file-if-exists=../../.env src/eval/ejecutar.ts",
    "eval:verificar": "tsx --env-file-if-exists=../../.env src/eval/verificar-informe.ts"
  },
  "dependencies": {
    "@aop/shared": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "decimal.js": "^10.4.3",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
