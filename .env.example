# ---------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores marcados como REQUERIDO.
#   cp .env.example .env
# El .env real esta en .gitignore y nunca debe subirse al repositorio.
# ---------------------------------------------------------------------------

# --- Entorno ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
# Origen del frontend en desarrollo, para CORS.
WEB_ORIGIN=http://localhost:5173

# --- Base de datos ---------------------------------------------------------
# El puerto 5440 evita chocar con otros Postgres locales (5432, 5433 y 5434 ocupados).
DATABASE_URL=postgres://originacion:originacion@localhost:5440/originacion

# --- Proveedor de LLM ------------------------------------------------------
# REQUERIDO a partir del modulo M7. Obtener en https://openrouter.ai/keys
# El enunciado impone OpenRouter con modelos gratuitos.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo principal y cascada de reserva, separados por coma.
#
# Comprobados contra la API el 22 de agosto de 2026. Los tres modelos que se
# habian elegido inicialmente (deepseek-chat-v3, llama-3.3-70b y qwen-2.5-72b en
# su variante :free) YA NO SON GRATUITOS: OpenRouter los movio a pago y ahora
# devuelven 404. El catalogo gratuito rota, asi que conviene reverificarlo antes
# de la entrega con:  node scripts/listar-modelos-gratuitos.mjs
#
# Los tres de abajo soportan llamada a herramientas Y salida estructurada, que
# es lo que necesitan M7 y M9. La cascada existe porque los modelos gratuitos
# devuelven 429 con frecuencia: z-ai/glm-5.2:free, por ejemplo, estaba limitado
# en el momento de la comprobacion.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,openrouter/free

# Cabeceras de atribucion que OpenRouter usa para el ranking publico. Opcionales.
OPENROUTER_APP_TITLE=Asistente de Originacion PyME
OPENROUTER_APP_URL=http://localhost:5173

# --- Topes de ejecucion del agente (modulo M7) -----------------------------
# Cortan el bucle del agente por diseno: sin esto no hay garantia de terminacion.
AGENT_MAX_ITERATIONS=8
AGENT_MAX_USD_PER_RUN=0.05
AGENT_TIMEOUT_MS=120000
