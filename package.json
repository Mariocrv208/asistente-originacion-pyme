{
  "name": "asistente-originacion-pyme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preparar": "node scripts/preparar.mjs",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @aop/api dev",
    "dev:web": "pnpm --filter @aop/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U originacion -d originacion",
    "db:nuke": "docker compose down -v",
    "db:migrate": "pnpm --filter @aop/api db:migrate",
    "db:verificar": "pnpm --filter @aop/api db:verificar",
    "corpus:cargar": "pnpm --filter @aop/api corpus:cargar",
    "corpus:verificar": "pnpm --filter @aop/api corpus:verificar",
    "finanzas:verificar": "pnpm --filter @aop/api finanzas:verificar",
    "datos:generar": "pnpm --filter @aop/api datos:generar",
    "datos:sembrar": "pnpm --filter @aop/api datos:sembrar",
    "datos:verificar": "pnpm --filter @aop/api datos:verificar",
    "recuperacion:verificar": "pnpm --filter @aop/api recuperacion:verificar",
    "llm:modelos": "node scripts/listar-modelos-gratuitos.mjs .env",
    "agente:verificar": "pnpm --filter @aop/api agente:verificar",
    "api:verificar": "pnpm --filter @aop/api api:verificar",
    "eval": "pnpm --filter @aop/api eval",
    "eval:verificar": "pnpm --filter @aop/api eval:verificar"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
